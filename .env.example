# Copy to .env for local development. Do not commit real secrets.
PORT=3000
BASE_URL=http://localhost:3000
CURRENCY=RUB

# Generate your own values; never use these placeholders as real credentials.
ADMIN_PASSWORD=replace-with-your-own-long-password
SESSION_SECRET=replace-with-a-cryptographically-random-secret

# Persistent database directory. On Railway mount a Volume at /app/data.
DATABASE_DIR=/app/data

# YooKassa credentials from your own merchant account (leave blank until approved).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram bot token from @BotFather and target chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prices are in kopecks: 49900 = 499.00 RUB. Replace demo prices before launch.
PRICE_STARTER=49900
PRICE_ADVANCED=99900
PRICE_ULTIMATE=199900
